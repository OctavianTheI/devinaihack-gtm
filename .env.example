# Copy to .env.local and fill in. Required by /api/training (voice + scoring).

# ElevenLabs — powers the cold-call prospect voice session (/api/training/voice).
ELEVENLABS_API_KEY=
# Optional: reuse an agent you configured in the ElevenLabs dashboard instead
# of letting the server auto-create one.
# ELEVENLABS_AGENT_ID=

# Scoring model — used by shared/scorer.ts (/api/training/score).
# Without it the scorer returns deterministic placeholder scores.
OPENAI_API_KEY=
# Optional overrides:
# SCORER_API_KEY=        # falls back to OPENAI_API_KEY
# SCORER_BASE_URL=       # default https://api.openai.com/v1
# SCORER_MODEL=          # default gpt-4o-mini
